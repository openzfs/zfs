#zstd
SRCS+=	zfs_zstd.c

#zstd/common
SRCS+=	entropy_common.c \
	error_private.c \
	fse_decompress.c \
	pool.c \
	zstd_common.c \

#zstd/compress
SRCS+=	fse_compress.c \
	hist.c \
	huf_compress.c \
	zstd_compress.c \
	zstd_compress_literals.c \
	zstd_compress_sequences.c \
	zstd_compress_superblock.c \
	zstd_double_fast.c \
	zstd_fast.c \
	zstd_lazy.c \
	zstd_ldm.c \
	zstd_opt.c \
	zstd_preSplit.c

#zstd/decompress
SRCS+=	huf_decompress.c \
	zstd_ddict.c \
	zstd_decompress_block.c \
	zstd_decompress.c

# Default CWARNFLAGS is -Wframe-larger-than=512 (Makefile.inc.netbsd).
# Linux Kbuild applies ZFS_ZSTD_FLAGS += -Wframe-larger-than=20480 to
# every zstd TU.  We do not raise the project default.  Per-file
# COPTS is the measured gcc-12/amd64 frame rounded up.  zstd_compress
# is 5280 bytes: 4096 does not compile it.  Lua/skein keep algorithm
# state on the stack (Linux ignores the warning in those TUs).
# VOP/HMAC pads in os/netbsd are heap-allocated instead.
COPTS.zstd_compress.c+= -Wframe-larger-than=6144
COPTS.hist.c+= -Wframe-larger-than=5120
COPTS.entropy_common.c+= -Wframe-larger-than=1024
COPTS.zstd_compress_sequences.c+= -Wframe-larger-than=768
COPTS.zstd_compress_superblock.c+= -Wframe-larger-than=768
COPTS.zstd_decompress_block.c+= -Wframe-larger-than=768
COPTS.skein_block.c+= -Wframe-larger-than=768
COPTS.lauxlib.c+= -Wframe-larger-than=768
COPTS.lstrlib.c+= -Wframe-larger-than=1024
COPTS.ltablib.c+= -Wframe-larger-than=768
COPTS.abd.c+= -Wframe-larger-than=768
COPTS.dmu_redact.c+= -Wframe-larger-than=768
COPTS.dmu_send.c+= -Wframe-larger-than=1024
COPTS.dsl_dataset.c+= -Wframe-larger-than=768
COPTS.range_tree.c+= -Wframe-larger-than=768
COPTS.spa.c+= -Wframe-larger-than=1024
COPTS.zcp.c+= -Wframe-larger-than=768
COPTS.zcp_iter.c+= -Wframe-larger-than=768
COPTS.zfs_ioctl.c+= -Wframe-larger-than=768
COPTS.zil.c+= -Wframe-larger-than=768
COPTS.zvol.c+= -Wframe-larger-than=768
COPTS.hkdf.c+= -Wframe-larger-than=768
# zio_crypt.c must come from os/netbsd/zfs (HMAC core copy).
.if !exists(${SRCDIR}/os/netbsd/zfs/zio_crypt.c)
.error NetBSD-owned zio_crypt.c missing; not compiling os/freebsd/zfs/zio_crypt.c
.endif
.if !exists(${SRCDIR}/zfs/hkdf.c)
.error shared module/zfs/hkdf.c missing
.endif
COPTS.zio_crypt.c+= -Wframe-larger-than=768

# Rebuild every compilation unit if the SYSCTL_INT link-set header
# changes.  Incremental make after 287 left stale .o files without
# the link_set_zfs_nb_sysctls section.
.for _s in ${SRCS:M*.c}
${_s:T:R}.o: ${INCDIR}/os/netbsd/spl/sys/sysctl.h
.endfor
spa_history.o: ${INCDIR}/zfs_gitrev.h

.include <bsd.kmodule.mk>

# bsd.sys.mk: COMPILE.c = CC ${CFLAGS} ${CPPFLAGS} -c
#             .c.o: ${COMPILE.c} ${COPTS.<file>} ${CPUFLAGS.<file>}
# CFLAGS+= here is not last.  Per-file CPUFLAGS is.  Use :T so
# SRCS with a directory prefix still match the compile slot.
.if ${MACHINE_ARCH} == "x86_64" || ${MACHINE_ARCH} == "amd64" || \
	${MACHINE_ARCH} == "i386"
_ZFS_NOSSE= -mno-mmx -mno-sse -mno-sse2 -mno-avx -mno-avx2 -msoft-float
.if ${ACTIVE_CC:U} == "clang" || ${CC:T} == "clang"
_ZFS_NOSSE+= -mno-implicit-float
.else
_ZFS_NOSSE+= -mgeneral-regs-only
.endif
_ZFS_SIMD_C= vdev_raidz_math_sse2.c vdev_raidz_math_ssse3.c \
	vdev_raidz_math_avx2.c vdev_raidz_math_avx512f.c \
	vdev_raidz_math_avx512bw.c zfs_fletcher_sse.c \
	zfs_fletcher_intel.c zfs_fletcher_avx512.c
.for _s in ${SRCS:M*.c}
.if empty(_ZFS_SIMD_C:M${_s:T})
CPUFLAGS.${_s:T}+= ${_ZFS_NOSSE}
.endif
.endfor
CPUFLAGS.vdev_raidz_math_sse2.c+= -mhard-float -msse2
CPUFLAGS.vdev_raidz_math_ssse3.c+= -mhard-float -mssse3
CPUFLAGS.zfs_fletcher_sse.c+= -mhard-float -msse2
.if ${MACHINE_ARCH} == "x86_64" || ${MACHINE_ARCH} == "amd64"
CPUFLAGS.vdev_raidz_math_avx2.c+= -mhard-float -mavx2
CPUFLAGS.vdev_raidz_math_avx512f.c+= -mhard-float -mavx512f
CPUFLAGS.vdev_raidz_math_avx512bw.c+= -mhard-float -mavx512bw
CPUFLAGS.zfs_fletcher_intel.c+= -mhard-float -mavx2
CPUFLAGS.zfs_fletcher_avx512.c+= -mhard-float -mavx512f
.endif
.endif

show-cc:
	@echo 'MACHINE_ARCH=${MACHINE_ARCH}'
	@echo 'CPUFLAGS.abd.c=${CPUFLAGS.abd.c}'
	@echo 'CPUFLAGS.zfs_crrd.c=${CPUFLAGS.zfs_crrd.c}'
	@echo 'COPTS.zfs_fletcher_sse.c=${COPTS.zfs_fletcher_sse.c}'
	@echo 'CPUFLAGS.zfs_fletcher_sse.c=${CPUFLAGS.zfs_fletcher_sse.c}'
	@echo 'CPUFLAGS.zfs_fletcher_intel.c=${CPUFLAGS.zfs_fletcher_intel.c}'
	@rm -f abd.o zfs_crrd.o zfs_fletcher.o zfs_fletcher_sse.o \
	    zfs_fletcher_intel.o zio_checksum.o
	${MAKE} -f Makefile.openzfs abd.o zfs_crrd.o zfs_fletcher.o \
	    zfs_fletcher_sse.o zfs_fletcher_intel.o zio_checksum.o
.PHONY: show-cc

# NetBSD 11.0 GENERIC still links sys/external/bsd/libnv (and a
# few libc leftovers).  OpenZFS ships its own copies; kobj_checksyms
# rejects the redefinitions.  Localize those prefixes only -- keep
# the rest of the symbol table for ddb.  Generated from nm so a
# new fnvlist_* upstream does not become a load-time surprise.
# Generated binary search code is particularly bad with this optimization.
# Oddly, range_tree.c is not affected when unrolling is not done and dsl_scan.c
# is not affected when unrolling is done.
# Disable it until the following upstream issue is resolved:
# https://github.com/llvm/llvm-project/issues/62790
.if ${CC} == "clang"
.if ${MACHINE_ARCH} == "i386" || ${MACHINE_ARCH} == "x86_64" || ${MACHINE_ARCH} == "amd64"
CFLAGS.dsl_scan.c= -mllvm -x86-cmov-converter=false
CFLAGS.metaslab.c= -mllvm -x86-cmov-converter=false
CFLAGS.range_tree.c= -mllvm -x86-cmov-converter=false
CFLAGS.zap_micro.c= -mllvm -x86-cmov-converter=false
.endif
.endif


CFLAGS.gcc+= -Wno-pointer-to-int-cast

CFLAGS.abd.c= -Wno-cast-qual
CFLAGS.ddt.c= -Wno-cast-qual
CFLAGS.ddt_log.c= -Wno-cast-qual -Wno-pointer-arith
CFLAGS.ddt_zap.c= -Wno-cast-qual
CFLAGS.dmu.c= -Wno-cast-qual
CFLAGS.dmu_traverse.c= -Wno-cast-qual
CFLAGS.dnode.c= ${NO_WUNUSED_BUT_SET_VARIABLE}
CFLAGS.dsl_deadlist.c= -Wno-cast-qual
CFLAGS.dsl_dir.c= -Wno-cast-qual
CFLAGS.dsl_prop.c= -Wno-cast-qual
CFLAGS.edonr.c= -Wno-cast-qual
CFLAGS.fm.c= -Wno-cast-qual
CFLAGS.hist.c= -U__BMI__ -fno-tree-vectorize ${NO_WBITWISE_INSTEAD_OF_LOGICAL}
CFLAGS.lapi.c= -Wno-cast-qual
CFLAGS.lcompat.c= -Wno-cast-qual
CFLAGS.ldo.c= ${NO_WINFINITE_RECURSION}
CFLAGS.lobject.c= -Wno-cast-qual
CFLAGS.ltable.c= -Wno-cast-qual
CFLAGS.lvm.c= -Wno-cast-qual
CFLAGS.lz4.c= -Wno-cast-qual
CFLAGS.lz4_zfs.c= -Wno-cast-qual
CFLAGS.nvpair.c= -Wno-cast-qual -DHAVE_RPC_TYPES ${NO_WSTRINGOP_OVERREAD}
CFLAGS.pool.c+= ${NO_WBITWISE_INSTEAD_OF_LOGICAL}
CFLAGS.pool.c+= -U__BMI__ -fno-tree-vectorize
CFLAGS.spa.c= -Wno-cast-qual
CFLAGS.spa_misc.c= -Wno-cast-qual
CFLAGS.spl_string.c= -Wno-cast-qual
CFLAGS.spl_vm.c= -Wno-cast-qual
