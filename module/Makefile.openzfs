# OpenZFS filesystem + SPL as openzfs.kmod.
# DTrace ABI (solaris_cpu / cpu_core / exported solaris_kmem_*)
# lives in solaris.kmod.  This module does not depend on it.
# LOCKDEBUG=1 omits cpu_core[] -- dtrace will not load; ZFS still builds.

.include <bsd.own.mk>

KMOD=	openzfs

.include "Makefile.inc.netbsd"

# os/netbsd/{zfs,spl} first.  Do not fall through to os/freebsd:
# hkdf.c would silently compile FreeBSD's OpenCrypto copy
# (<sys/freebsd_crypto.h>) instead of shared module/zfs/hkdf.c.
# zio_crypt.c is still exists-guarded below as a second belt.
.PATH:	${SRCDIR}/lua \
	${SRCDIR}/nvpair \
	${SRCDIR}/avl \
	${SRCDIR}/icp/algs/blake3 \
	${SRCDIR}/icp/algs/edonr \
	${SRCDIR}/icp/algs/sha2 \
	${SRCDIR}/icp/algs/skein \
	${SRCDIR}/icp/asm-aarch64/blake3 \
	${SRCDIR}/icp/asm-aarch64/sha2 \
	${SRCDIR}/icp/asm-arm/sha2 \
	${SRCDIR}/icp/asm-ppc64/sha2 \
	${SRCDIR}/icp/asm-ppc64/blake3 \
	${SRCDIR}/icp/asm-x86_64/blake3 \
	${SRCDIR}/icp/asm-x86_64/sha2 \
	${SRCDIR}/icp/algs/aes \
	${SRCDIR}/icp/algs/modes \
	${SRCDIR}/os/netbsd/zfs \
	${SRCDIR}/os/netbsd/spl \
	${SRCDIR}/zcommon \
	${SRCDIR}/zfs \
	${SRCDIR}/zstd \
	${SRCDIR}/zstd/lib/common \
	${SRCDIR}/zstd/lib/compress \
	${SRCDIR}/zstd/lib/decompress

SRCS=	# no FreeBSD vnode_if/bus_if generated headers



# SPL.  DTrace CPU arrays are not here -- they are solaris.kmod.
SRCS+=	avl.c \
	u8_textprep.c \
	acl_common.c \
	callb.c \
	list.c \
	spl_acl.c \
	spl_atomic.c \
	spl_cmn_err.c \
	spl_kmem.c \
	spl_kstat.c \
	spl_misc.c \
	spl_procfs_list.c \
	spl_string.c \
	spl_sunddi.c \
	spl_taskq.c \
	spl_uio.c \
	spl_uvm_pin.c \
	spl_vfs.c \
	spl_vm.c \
	spl_zlib.c \
	spl_zone.c \
	spl_compat.c \
	xdr.c \
	xdr_mem.c \
	xdr_array.c \
	spl_kobj.c \
	solaris_kmod.c

#icp/algs/skein
SRCS+=	skein.c \
	skein_block.c \
	skein_iv.c

#icp/algs/blake3
SRCS+=	blake3.c \
	blake3_generic.c \
	blake3_impl.c

# aarch64: do not add b3_aarch64_sse2.S / sse41.S.  NetBSD kobj_reloc
# cannot apply R_AARCH64_LDST128 (modload ENOEXEC).  blake3_impl.c
# stays on the generic C ops unless HAVE_BLAKE3_SSE2_ASM is set.
# amd64 still ships blake3_{sse2,sse41,avx2,avx512}.S below.

.if ${MACHINE_ARCH} == "powerpc64le"
#icp/asm-ppc64/blake3 -- LE-only VSX helpers
SRCS+=	b3_ppc64le_sse2.S \
	b3_ppc64le_sse41.S
CPPFLAGS+=	-DHAVE_BLAKE3_SSE2_ASM
.endif

.if ${MACHINE_ARCH} == "x86_64" || ${MACHINE_ARCH} == "amd64"
# icp/asm-x86_64 -- real blake3/sha2, dispatched by simd_x86.h
# after fpu_kern_enter.  i386 cannot assemble these (64-bit regs).
SRCS+=	blake3_avx2.S \
	blake3_avx512.S \
	blake3_sse2.S \
	blake3_sse41.S \
	sha256-x86_64.S \
	sha512-x86_64.S
CPPFLAGS+=	-DHAVE_BLAKE3_SSE2_ASM -DHAVE_BLAKE3_AVX_ASM
.endif

#icp/algs/edonr
SRCS+=	edonr.c

#icp/algs/sha2
SRCS+=	sha256_impl.c \
	sha2_generic.c \
	sha512_impl.c

# Portable AES-GCM / AES-CCM (no AES-NI / PCLMUL on this path).
SRCS+=	aes_impl.c \
	aes_impl_generic.c \
	aes_impl_stubs.c \
	aes_modes.c \
	modes.c \
	gcm.c \
	gcm_generic.c \
	ccm.c \
	icp_aead.c

.if !empty(MACHINE_ARCH:Mearmv7*) || ${MACHINE_ARCH} == "armv7"
# ARMv7 SHA only.  earmv6* cannot assemble or run these.
SRCS+=	sha256-armv7.S \
	sha512-armv7.S
.endif

.if ${MACHINE_ARCH} == "aarch64" || ${MACHINE_ARCH} == "aarch64eb"
#icp/asm-aarch64/sha2 (also provides zfs_sha*_block_armv7)
SRCS+=	sha256-armv8.S \
	sha512-armv8.S
.endif

.if ${MACHINE_ARCH} == "powerpc64" || ${MACHINE_ARCH} == "powerpc64le"
#icp/asm-ppc64/sha2
SRCS+=	sha256-p8.S \
	sha256-ppc.S \
	sha512-p8.S \
	sha512-ppc.S
.endif

# SIMD C files: ISA flags also go in CPUFLAGS (the real last
# slot, see post-bsd.kmodule.mk).  COPTS still carries them so
# a compile that omits per-file CPUFLAGS stays hard-float.
# -mhard-float undoes CFLAGS -msoft-float.  -mimplicit-float is clang-only.
.if ${MACHINE_ARCH} == "x86_64" || ${MACHINE_ARCH} == "amd64" || \
	${MACHINE_ARCH} == "i386"
_ZFS_X86_SIMD= -mhard-float -DZFS_SIMD_TU
.if ${ACTIVE_CC:U} == "clang" || ${CC:T} == "clang"
_ZFS_X86_SIMD+= -mimplicit-float
.endif
COPTS.vdev_raidz_math_sse2.c+= ${_ZFS_X86_SIMD} -msse2
COPTS.vdev_raidz_math_ssse3.c+= ${_ZFS_X86_SIMD} -mssse3
COPTS.zfs_fletcher_sse.c+= ${_ZFS_X86_SIMD} -msse2
.endif
.if ${MACHINE_ARCH} == "x86_64" || ${MACHINE_ARCH} == "amd64"
COPTS.vdev_raidz_math_avx2.c+= ${_ZFS_X86_SIMD} -mavx2
COPTS.vdev_raidz_math_avx512f.c+= ${_ZFS_X86_SIMD} -mavx512f
COPTS.vdev_raidz_math_avx512bw.c+= ${_ZFS_X86_SIMD} -mavx512bw
COPTS.zfs_fletcher_intel.c+= ${_ZFS_X86_SIMD} -mavx2
COPTS.zfs_fletcher_avx512.c+= ${_ZFS_X86_SIMD} -mavx512f
.endif

.if ${MACHINE_ARCH} == "aarch64" || ${MACHINE_ARCH} == "aarch64eb"
# Linux Kbuild: compile neon + neonx2, CFLAGS_REMOVE -mgeneral-regs-only.
# No -mfpu: ASIMD is the aarch64 baseline.  is_supported is kfpu_allowed(),
# which is the AdvSIMD intersection (any little core without SIMD
# disables every SIMD impl).
SRCS+=	vdev_raidz_math_aarch64_neon.c \
	vdev_raidz_math_aarch64_neonx2.c \
	spl_kfpu.c
.endif

.if ${MACHINE_ARCH} == "powerpc" || ${MACHINE_ARCH} == "powerpc64" || \
	${MACHINE_ARCH} == "powerpc64le"
# Linux Kbuild: vdev_raidz_math_powerpc_altivec.o + -maltivec.
# is_supported is kfpu_allowed() && zfs_altivec_available().
# spl_kfpu.c zeros with vxor / xxlxor via .machine directives.
# Do not pass -maltivec/-mvsx on that TU -- it would switch the
# C ABI and let the compiler save/restore the regs we sanitize.
SRCS+=	vdev_raidz_math_powerpc_altivec.c \
	spl_kfpu.c
COPTS.vdev_raidz_math_powerpc_altivec.c+= -maltivec
.endif

#lua
SRCS+=	lapi.c \
	lauxlib.c \
	lbaselib.c \
	lcode.c \
	lcompat.c \
	lcorolib.c \
	lctype.c \
