.if ${MACHINE_ARCH} == "aarch64" || ${MACHINE_ARCH} == "aarch64eb"

# Linux CFLAGS_REMOVE_*.o += -mgeneral-regs-only.  GENERIC64 also
# passes -march=armv8-a+nofp+nosimd; strip that and compile SIMD
# TUs as armv8-a so AdvSIMD (eor v0.16b) assembles.
#
# Compile to .o.o then CTFCONVERT_RUN -- writing .o directly left
# neon objects without CTF and ctfmerge failed.
AARCH64_ASM_FLAGS= ${AARCH64_SIMD_CFLAGS:N-include:N*ccompile.h:N*simd_config.h} \
	${CPPFLAGS:N-include:N*ccompile.h:N*simd_config.h} -DLOCORE

vdev_raidz_math_aarch64_neon.o: vdev_raidz_math_aarch64_neon.c
	${CC} -c ${AARCH64_SIMD_CFLAGS} ${CPPFLAGS} ${WERROR} \
	    -o ${.TARGET}.o ${.IMPSRC}
	${CTFCONVERT_RUN}

vdev_raidz_math_aarch64_neonx2.o: vdev_raidz_math_aarch64_neonx2.c
	${CC} -c ${AARCH64_SIMD_CFLAGS} ${CPPFLAGS} ${WERROR} \
	    -o ${.TARGET}.o ${.IMPSRC}
	${CTFCONVERT_RUN}

zfs_fletcher_aarch64_neon.o: zfs_fletcher_aarch64_neon.c
	${CC} -c ${AARCH64_SIMD_CFLAGS} ${CPPFLAGS} ${WERROR} \
	    -o ${.TARGET}.o ${.IMPSRC}
	${CTFCONVERT_RUN}

sha256-armv8.o: sha256-armv8.S
	${CC} -c ${AARCH64_ASM_FLAGS} ${WERROR} \
	    -o ${.TARGET} ${.IMPSRC}

sha512-armv8.o: sha512-armv8.S
	${CC} -c ${AARCH64_ASM_FLAGS} ${WERROR} \
	    -o ${.TARGET} ${.IMPSRC}

.endif
