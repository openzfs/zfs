CFLAGS.zstd_common.c= -U__BMI__ -fno-tree-vectorize ${NO_WBITWISE_INSTEAD_OF_LOGICAL} -DZSTD_TRACE=0 -DZSTD_HAVE_WEAK_SYMBOLS=0
