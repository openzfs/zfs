#
# Runfile for comma-separated multi-pool import and related
# parallel import coverage.
#

[DEFAULT]
pre = setup
quiet = False
pre_user = root
user = root
timeout = 1200
post_user = root
post = cleanup
failsafe_user = root
failsafe = callbacks/zfs_failsafe
tags = ['multi-import']

[tests/functional/cli_root/zpool_import]
tests = ['zpool_import_multi_pos', 'zpool_import_multi_neg',
    'zpool_import_multi_parallel', 'zpool_import_parallel_pos',
    'zpool_import_parallel_neg', 'zpool_import_parallel_admin',
    'zpool_import_all_001_pos', 'zpool_import_rename_001_pos']
tags = ['functional', 'cli_root', 'zpool_import', 'multi-import']
timeout = 1200
