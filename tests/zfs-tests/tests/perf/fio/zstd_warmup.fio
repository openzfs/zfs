[global]
filename_format=file$jobnum
fallocate=0
overwrite=0
thread=1
rw=read
time_based=0
size=${FILE_SIZE}
directory=${DIRECTORY}
bs=${BLOCKSIZE}
ioengine=psync
sync=${SYNC_TYPE}
direct=${DIRECT}
numjobs=${NUMJOBS}

[job]
