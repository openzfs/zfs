. $STF_SUITE/include/libtest.shlib
. $STF_SUITE/tests/functional/userquota/userquota.cfg

#
# reset the userquota and groupquota and delete temporary files
#
function cleanup_quota
{
	if datasetexists $QFS; then
		log_must zfs set userquota@$QUSER1=none $QFS
		log_must zfs set userobjquota@$QUSER1=none $QFS
		log_must zfs set userquota@$QUSER2=none $QFS
		log_must zfs set userobjquota@$QUSER2=none $QFS
		log_must zfs set groupquota@$QGROUP=none $QFS
		log_must zfs set groupobjquota@$QGROUP=none $QFS
		log_must zfs set defaultuserquota=none $QFS
		log_must zfs set defaultuserobjquota=none $QFS
		log_must zfs set defaultgroupquota=none $QFS
		log_must zfs set defaultgroupobjquota=none $QFS
		recovery_writable $QFS
	fi

	[[ -f $QFILE ]] && log_must rm -f $QFILE
	[[ -f $OFILE ]] && log_must rm -f $OFILE
	[[ -f $QFILE2 ]] && log_must rm -f $QFILE2
	[[ -f $OFILE2 ]] && log_must rm -f $OFILE2
	rm -f "$TEST_BASE_DIR/quota" "$TEST_BASE_DIR/setquota"
	sync_all_pools

	return 0
}

#
# Configure QUOTA_MODE ("quota_tools" or "quotactl_fd") for Linux
# quotactl_fd(2) tests.
#
# Upstream quota-tools added native ZFS quotactl_fd(2) support in
# commit 8e534bdc8281 ("Enable support for ZFS quotas via quotactl_fd").
# On distributions shipping older quota-tools (>= 4.10, which added
# tmpfs quotactl_fd support), copy the binaries and patch "tmpfs" to
# "zfs\0\0" as a fallback.  On quota-tools <= 4.09 (which only use
# legacy quotactl(2)), verify the expected error text and fall back to
# the quotactl_fd test helper on kernels >= 5.14.
#
function setup_quota_tools
{
	if ! is_linux; then
		log_unsupported "quotactl_fd is a Linux-specific interface"
	fi

	typeset sys_quota
	typeset sys_setquota
	sys_quota=$(command -v quota)
	sys_setquota=$(command -v setquota)

	if [[ -n "$sys_quota" && -n "$sys_setquota" ]]; then
		if "$sys_quota" --filesystem="$TESTDIR" -u $QUSER1 \
		    >/dev/null 2>&1; then
			export QUOTA_MODE="quota_tools"
			export QUOTA_CMD="$sys_quota"
			export SETQUOTA_CMD="$sys_setquota"
			return 0
		fi

		export QUOTA_CMD="$TEST_BASE_DIR/quota"
		export SETQUOTA_CMD="$TEST_BASE_DIR/setquota"
		log_must cp "$sys_quota" "$QUOTA_CMD"
		log_must cp "$sys_setquota" "$SETQUOTA_CMD"
		log_must env LC_ALL=C sed -i 's/tmpfs/zfs\x0\x0/g' \
		    "$QUOTA_CMD" "$SETQUOTA_CMD"
		log_must chmod +x "$QUOTA_CMD" "$SETQUOTA_CMD"

		typeset err
		err=$("$QUOTA_CMD" --filesystem="$TESTDIR" -u $QUSER1 2>&1)
		if [[ $? -eq 0 ]]; then
			export QUOTA_MODE="quota_tools"
			return 0
		fi

		rm -f "$QUOTA_CMD" "$SETQUOTA_CMD"
		unset QUOTA_CMD SETQUOTA_CMD

		#
		# Older quota-tools (e.g. 4.04 on RHEL/Alma 8) lacks
		# --filesystem=<path> and rejects it as --filesystem-list.
		# Re-run with -f <path> to verify the expected legacy error.
		#
		if echo "$err" | grep -qi "doesn't allow an argument"; then
			err=$("$sys_quota" -f "$TESTDIR" 2>&1)
		fi
		if ! echo "$err" | grep -qiE \
		    "not found or has no quota enabled|Function not implemented"; then
			log_fail "Unexpected quota(1) failure: $err"
		fi
		log_note "quota-tools <= 4.09 failed as expected: $err"
	fi

	if ! command -v quotactl_fd >/dev/null 2>&1; then
		log_unsupported "quota-tools >= 4.10 or quotactl_fd required"
	fi

	typeset qerr
	qerr=$(quotactl_fd get "$TESTDIR" usr 999999 2>&1)
	if [[ $? -ne 0 ]]; then
		if echo "$qerr" | grep -qi "Function not implemented"; then
			log_unsupported "kernel quotactl_fd(2) not supported"
		fi
		log_fail "quotactl_fd probe failed: $qerr"
	fi

	log_note "Kernel 5.14+ with quota-tools < 4.10: falling back to quotactl_fd"
	export QUOTA_MODE="quotactl_fd"
}

function quota_id_to_num
{
	[[ "$2" == +([0-9]) ]] && { echo "$2"; return 0; }
	typeset g
	case "$1" in
	usr)	id -u "$2" ;;
	grp)	g=$(getent group "$2"); g=${g#*:*:}; echo "${g%%:*}" ;;
	*)	echo "$2" ;;
	esac
}

function do_quota
{
	typeset -a cmd cols
	typeset usr="" flag="-X" col key out val
	[[ "$1" == "-U" ]] && { usr=$2; shift 2; }
	typeset mnt=$1 qtype=$2 id=$3 field=$4
	case "$qtype" in
	usr) flag="-u" ;; grp) flag="-g" ;; prj) flag="-P" ;;
	esac
	if [[ "$QUOTA_MODE" == "quota_tools" ]]; then
		cmd=("$QUOTA_CMD" -v -w -p --filesystem="$mnt" "$flag" "$id")
	else
		cmd=(quotactl_fd get "$mnt" "$qtype" \
		    "$(quota_id_to_num "$qtype" "$id")")
	fi
	[[ -n "$usr" ]] && cmd=(user_run "$usr" "${cmd[@]}")
	[[ -z "$field" ]] && { "${cmd[@]}"; return $?; }
	out=$("${cmd[@]}") || return $?
	case "$field" in
	blocks)	    col=1; key=curspace ;;
	bhardlimit) col=3; key=bhardlimit ;;
	files)	    col=5; key=curinodes ;;
	ihardlimit) col=7; key=ihardlimit ;;
	esac
	if [[ "$QUOTA_MODE" == "quota_tools" ]]; then
		read -rA cols <<<"${out##*$'\n'}"
		echo "${cols[col]%\*}"
	else
		out=$'\n'$out
		val=${out#*$'\n'"$key"=}
		val=${val%%$'\n'*}
		[[ "$field" == "blocks" ]] && echo $((val / 1024)) || echo "$val"
	fi
}

function do_setquota
{
	typeset -a cmd
	typeset usr="" flag="-X"
	[[ "$1" == "-U" ]] && { usr=$2; shift 2; }
	typeset mnt=$1 op=$2 id=$3 kb=$4 ino=${5:-0}
	case "$op" in
	usr) flag="-u" ;; grp) flag="-g" ;; prj) flag="-P" ;;
	esac
	if [[ "$QUOTA_MODE" == "quota_tools" ]]; then
		case "$op" in
		grace)	   cmd=("$SETQUOTA_CMD" -u "$id" -T unset unset \
			       "$mnt") ;;
		graceinfo) cmd=("$SETQUOTA_CMD" -u -t 86400 86400 "$mnt") ;;
		*)	   cmd=("$SETQUOTA_CMD" "$flag" "$id" "$kb" "$kb" \
			       "$ino" "$ino" "$mnt") ;;
		esac
	else
		case "$op" in
		grace)	   cmd=(quotactl_fd setmask "$mnt" usr \
			       "$(quota_id_to_num usr "$id")" 48) ;;
		graceinfo) cmd=(quotactl_fd setinfo "$mnt" usr) ;;
		*)	   cmd=(quotactl_fd set "$mnt" "$op" \
			       "$(quota_id_to_num "$op" "$id")" \
			       $((kb * 1024)) "$ino") ;;
		esac
	fi
	[[ -n "$usr" ]] && cmd=(user_run "$usr" "${cmd[@]}")
	"${cmd[@]}"
}

#
# delete user and group that created during the test
#
function clean_user_group
{
	for usr in $QUSER1 $QUSER2; do
		log_must del_user $usr
	done

	log_must del_group $QGROUP

	return 0
}

#
#  make the $QFS's mountpoint writable for all users
#
function mkmount_writable
{
	typeset fs=$1
	typeset mntp=$(get_prop mountpoint $fs)
	log_must chmod 0777 $mntp
}

#
# recovery the directory permission for $QFS
#
function recovery_writable
{
	typeset fs=$1
	typeset mntp=$(get_prop mountpoint $fs)
	log_must chmod 0755 $mntp
}

#
# check the quota value of a specific FS
#
function check_quota
{
	typeset fs=$2
	typeset prop=$1
	typeset expected=$3
	typeset value=$(get_prop $prop $fs)

	if (($value != $expected)); then
		return 1
	fi
}
