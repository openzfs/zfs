args = ...
argv = args["argv"]
snap = argv[1]
fs = argv[2]

-- clone names zfs(8) rejects must be rejected here too
assert(zfs.sync.clone(snap, fs .. "/bad%name") == EINVAL)
assert(zfs.sync.clone(snap, fs .. "/bad*name") == EINVAL)
assert(zfs.sync.clone(snap, fs .. "/bad@name") == EINVAL)
