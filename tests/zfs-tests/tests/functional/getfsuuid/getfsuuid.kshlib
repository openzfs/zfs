. $STF_SUITE/include/libtest.shlib

#
# Run getfsuuid on a path, and set uuid, pool_half, and ds_half from its
# output: the UUID as 32 hex digits, and the decimal pool guid and dataset
# guid that the two halves of the UUID hold.
#
function get_uuid # path
{
	typeset out

	out=$(getfsuuid $1) || log_fail "getfsuuid failed on $1"
	read -r uuid pool_half ds_half <<<"$out"
	log_note "uuid of $1: $uuid"
}

#
# Run getfsuuid on a path that must have no UUID, and verify that it fails
# with exit status 2, which it returns when the ioctl fails with ENOTTY.
# Any other status, including success, fails the test.
#
function verify_no_uuid # path
{
	typeset out
	typeset -i ret

	out=$(getfsuuid $1 2>&1)
	ret=$?
	log_note "getfsuuid $1: exit status $ret: $out"
	(( ret == 2 )) ||
	    log_fail "getfsuuid $1 exited with status $ret, expected 2"
}
